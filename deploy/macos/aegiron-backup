#!/bin/bash
# Daily Aegiron backup (run by launchd as root at 02:30; safe to run by hand with sudo).
#   database  -> /usr/local/var/aegiron/backups/db-YYYYmmdd-HHMM.dump   (pg_dump custom format)
#   keys      -> /usr/local/var/aegiron/backups/keys-YYYYmmdd-HHMM.tar   (server identity + vault key)
# Copy keys-*.tar to a different place than db-*.dump: together they reveal stored passwords.
# Restore: pg_restore --clean --if-exists -d "$AEGIRON_DATABASE_URL" db-....dump
set -euo pipefail
ENV_FILE="${AEGIRON_ENV_FILE:-/usr/local/etc/aegiron/aegiron.env}"
DEST="${AEGIRON_BACKUP_DIR:-/usr/local/var/aegiron/backups}"
KEEP_DAYS=14

set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a
PG_DUMP="${PG_BIN:+$PG_BIN/}pg_dump"
command -v "$PG_DUMP" >/dev/null || PG_DUMP="$(command -v pg_dump || true)"
[ -n "$PG_DUMP" ] || { echo "pg_dump not found"; exit 1; }

umask 077
mkdir -p "$DEST"
stamp="$(date +%Y%m%d-%H%M)"
"$PG_DUMP" --format=custom --file="$DEST/db-$stamp.dump" "$AEGIRON_DATABASE_URL"
tar -cf "$DEST/keys-$stamp.tar" -C "$AEGIRON_DATA_DIR" server_ed25519.key vault.key
find "$DEST" -name 'db-*.dump' -mtime +"$KEEP_DAYS" -delete
find "$DEST" -name 'keys-*.tar' -mtime +"$KEEP_DAYS" -delete
echo "$(date '+%F %T') backup ok: db-$stamp.dump ($(du -h "$DEST/db-$stamp.dump" | cut -f1)), keys-$stamp.tar"
