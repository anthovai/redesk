# xrdp on Debian: a Linux RDP server for exercising the gateway. It is NOT a Windows host.
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xrdp xorgxrdp xterm x11-xserver-utils xclip dbus-x11 ssl-cert fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && adduser xrdp ssl-cert \
    && useradd -m -s /bin/bash aegiron
COPY rdp-entrypoint.sh /entrypoint.sh
EXPOSE 3389
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
